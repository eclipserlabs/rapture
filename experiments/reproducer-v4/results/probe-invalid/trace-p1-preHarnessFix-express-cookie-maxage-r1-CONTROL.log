import express from './index.js';
import http from 'http';
function get(path){return new Promise((resolve,reject)=>{
  const app = express();
  app.get("/session", (req, res) => {
    const ttl = req.query.ttl === "persist" ? 3600000 : undefined;
    res.cookie("sid", "abc123", { maxAge: ttl, httpOnly: true });
    const set = res.getHeader("Set-Cookie");
    const header = Array.isArray(set) ? set.join("; ") : String(set ?? "");
    if (/Invalid Date/i.test(header)) { res.status(500).json({ error: "malformed" }); return; }
    res.json({ ok: true });
  });
  const server = app.listen(0, ()=>{
    const port = server.address().port;
    http.get({port, path}, (res)=>{
      let b=''; res.on('data',c=>b+=c);
      res.on('end',()=>{ server.close(); resolve({status:res.statusCode, setCookie:res.headers['set-cookie'], body:b}); });
    }).on('error',(e)=>{server.close(); reject(e)});
  });
});}
for (const p of ['/session','/session?ttl=persist']) {
  const r = await get(p);
  console.log('PATH',p,'status',r.status,'set-cookie',r.setCookie,'body',r.body);
}
// edge cases
import express2 from './index.js';
async function cookieTest(opts, label){
  const app = express2();
  app.use((req,res)=>{ try{ res.cookie('n','tobi',opts); res.json({hdr:res.getHeader('Set-Cookie')}); }catch(e){ res.status(500).json({err:String(e)}) } });
  const srv = app.listen(0);
  await new Promise(r=>srv.on('listening',r));
  const port = srv.address().port;
  const out = await new Promise((res,rej)=>{ http.get({port,path:'/'},(r)=>{let b='';r.on('data',c=>b+=c);r.on('end',()=>res({status:r.statusCode,body:b}))}).on('error',rej)});
  console.log(label, JSON.stringify(opts), '=>', out.status, out.body.slice(0,300));
  srv.close();
}
await cookieTest({maxAge:undefined}, 'undefined');
await cookieTest({}, 'absent');
await cookieTest({maxAge:null}, 'null');
await cookieTest({maxAge:1000}, '1000');
await cookieTest({maxAge:'foobar'}, 'foobar');
