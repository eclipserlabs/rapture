async function prefixCheck(outer, inner) {
  const app = F();
  let seen='';
  await app.register(async (api) => {
    await api.register(async (v1) => { seen = v1.prefix; v1.get('/x', async()=>({ok:1})); }, { prefix: inner });
  }, { prefix: outer });
  await app.ready();
  const res = await app.inject({method:'GET', url: seen+'/x'});
  console.log(JSON.stringify({outer, inner, prefix: seen, status: res.statusCode}));
  await app.close();
}
