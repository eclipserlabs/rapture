const Request = require('./lib/request');
const TpRequest = Request.buildRequest(Request, true);
function mk(headers, remote='127.0.0.1'){
  const req={method:'GET',url:'/',socket:{remoteAddress:remote},headers};
  const r=new TpRequest('id',{},req,'','log',{});
  return r;
}
let r1 = mk({host:'internal:49700','x-forwarded-host':'api.example.com:8443'});
console.log('incident case: host',r1.host,'port',r1.port,'hostname',r1.hostname, r1.port===8443?'PASS':'FAIL');
let r2 = mk({host:'127.0.0.1:3000','x-forwarded-host':'fastify.test'});
console.log('no-port forwarded: host',r2.host,'port',r2.port,'hostname',r2.hostname);
let r3 = mk({host:'example.com:80'});
// regular (no trust) - use base Request directly
const R2 = Request;
let rr = new R2('id',{}, {method:'GET',url:'/',socket:{remoteAddress:'ip'},headers:{host:'example.com:80'}},'','log',{});
console.log('regular',rr.host,rr.port, rr.port===80?'PASS':'FAIL');
// untrusted: trust only 10.0.0.1, connect from 127.0.0.1 with spoofed forwarded
const TpUntrusted = Request.buildRequest(Request, '10.0.0.1');
let ru = new TpUntrusted('id',{}, {method:'GET',url:'/',socket:{remoteAddress:'127.0.0.1'},headers:{host:'real.test:3000','x-forwarded-host':'evil.com:8443'}},'','log',{});
console.log('untrusted: host',ru.host,'port',ru.port, (ru.host==='real.test:3000'&&ru.port===3000)?'PASS':'FAIL');
// ipv6
let r6 = new R2('id',{}, {method:'GET',url:'/',socket:{},headers:{host:'[::1]:80'}},'','log',{});
console.log('ipv6',r6.host,r6.port,r6.hostname, r6.port===80?'PASS':'FAIL');
let r6b = mk({host:'[::1]:3000','x-forwarded-host':'[::1]:8443'});
console.log('ipv6 forwarded',r6b.host,r6b.port,r6b.hostname, r6b.port===8443?'PASS':'FAIL');
"
