import('/work/repo/lib/request.js').then(async (Request)=>{
  const build=Request.buildRequest;
  function mk(headers, socketAddr, trust){
    const Tp = trust ? build(Request, trust) : Request;
    const req={method:'GET',url:'/',socket:socketAddr?{remoteAddress:socketAddr}:socketAddr,headers};
    return new Tp('id','params',req,'query','log');
  }
  // trusted XFH with port
  console.log('1', mk({host:'internal:3000','x-forwarded-host':'api.example.com:8443'},'127.0.0.1',true).port, '(expect 8443)');
  console.log('1 host', mk({host:'internal:3000','x-forwarded-host':'api.example.com:8443'},'127.0.0.1',true).host);
  // trusted XFH without port
  console.log('2', mk({host:'internal:3000','x-forwarded-host':'fastify.test'},'127.0.0.1',true).port, '(expect null strict)');
  // untrusted
  console.log('3', mk({host:'internal:3000','x-forwarded-host':'evil:9999'},'127.0.0.1','10.0.0.1').port, '(expect 3000)');
  console.log('3 host', mk({host:'internal:3000','x-forwarded-host':'evil:9999'},'127.0.0.1','10.0.0.1').host);
  // no trustProxy ignores XFH
  const r=mk({host:'example.com:1234','x-forwarded-host':'evil:9999'},'127.0.0.1',false);
  console.log('4',r.port,'(expect 1234) host',r.host);
  // ipv6
  console.log('5', mk({host:'[::1]:3000'},'127.0.0.1',false).port, mk({host:'[::1]:3000'},'127.0.0.1',false).hostname);
  console.log('6', mk({host:'internal:3000','x-forwarded-host':'[::1]:8443'},'127.0.0.1',true).port, mk({host:'internal:3000','x-forwarded-host':'[::1]:8443'},'127.0.0.1',true).hostname);
  // authority fallback with trust
  console.log('7', mk({':authority':'example.com:443'},'127.0.0.1',true).port, '(expect 443)');
  // multiple XFH entries
  console.log('8', mk({host:'internal:3000','x-forwarded-host':'a.com:1111, b.com:2222'},'127.0.0.1',true).port, '(expect 2222) host', mk({host:'internal:3000','x-forwarded-host':'a.com:1111, b.com:2222'},'127.0.0.1',true).host);
  // null socket
  console.log('9', mk({host:'real:3000','x-forwarded-host':'spoof:9999'},null,true).port, '(expect 3000) host', mk({host:'real:3000','x-forwarded-host':'spoof:9999'},null,true).host);
});
