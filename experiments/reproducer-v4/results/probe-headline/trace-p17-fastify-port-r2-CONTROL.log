import('/work/repo/fastify.js').then(async ({default:Fastify})=>{
  const app=Fastify({trustProxy:true});
  app.get('/callback-url', async (req,reply)=>{
    const port=req.port; const host=req.host;
    const expected=host && host.includes(':') ? Number(host.split(':').pop()) : null;
    console.log('host=',host,'port=',port,'hostname=',req.hostname);
    if(expected!=null && port!==expected) return reply.code(500).send({error:'derived port disagrees',host:String(host),port:String(port)});
    return {ok:true, url:'https://'+host+'/cb'};
  });
  await app.listen({port:0, host:'127.0.0.1'});
  const addr=app.server.address();
  console.log('listening',addr);
  let res=await fetch('http://127.0.0.1:'+addr.port+'/callback-url',{headers:{'x-forwarded-host':'api.example.com:8443'}});
  console.log('case1 status',res.status, await res.text());
  res=await fetch('http://127.0.0.1:'+addr.port+'/callback-url',{headers:{'x-forwarded-host':'fastify.test'}});
  console.log('case2 XFH no port: status',res.status, await res.text());
  // check req values directly via inject-like
  await app.close();
  // non-trustProxy check
  const app2=Fastify({});
  app2.get('/', async (req)=>({host:req.host,port:req.port,hostname:req.hostname}));
  const r=await app2.inject({method:'GET',url:'/',headers:{host:'example.com:1234','x-forwarded-host':'evil.com:9999'}});
  console.log('no-trustProxy (should ignore XFH):',r.body);
  await app2.close();
});
