const Request = require("./lib/request");
const build = Request.buildRequest;
function mk(headers, remote="127.0.0.1") {
  const req = { method:"GET", url:"/", socket:{remoteAddress:remote}, headers };
  const Tp = build(Request, true);
  return new Tp("id",{},req,"","log");
}
// incident: forwarded with port
let r = mk({host:"127.0.0.1:52176","x-forwarded-host":"api.example.com:8443"});
console.log("incident host="+r.host+" port="+r.port+" hostname="+r.hostname+" expect 8443:", r.port===8443?"PASS":"FAIL");
// forwarded without port -> fallback server port
r = mk({host:"127.0.0.1:3000","x-forwarded-host":"fastify.test"});
console.log("no-port host="+r.host+" port="+r.port+" expect 3000 (fallback):", r.port===3000?"PASS":"FAIL");
// untrusted
const TpUntrusted = build(Request, "10.0.0.1");
let req2 = { method:"GET", url:"/", socket:{remoteAddress:"127.0.0.1"}, headers:{host:"real.test:3000","x-forwarded-host":"evil.com:8443"} };
let ru = new TpUntrusted("id",{},req2,"","log");
console.log("untrusted host="+ru.host+" port="+ru.port+" expect real.test:3000/3000:", (ru.host==="real.test:3000"&&ru.port===3000)?"PASS":"FAIL");
// multiple entries with port in last
r = mk({host:"127.0.0.1:3000","x-forwarded-host":"example2.com, api.example.com:8443"});
console.log("multi host="+r.host+" port="+r.port+" expect 8443:", r.port===8443?"PASS":"FAIL");
// ipv6 forwarded with port
r = mk({host:"127.0.0.1:3000","x-forwarded-host":"[::1]:8443"});
console.log("ipv6 host="+r.host+" port="+r.port+" expect 8443:", r.port===8443?"PASS":"FAIL");
// ipv6 without port
r = mk({host:"[::1]:3000","x-forwarded-host":"[::1]"});
console.log("ipv6-noport host="+r.host+" port="+r.port+" expect 3000 fallback:", r.port===3000?"PASS":"FAIL");
// no forwarded -> host header
r = mk({host:"example.com:5000"});
console.log("no-fwd host="+r.host+" port="+r.port+" expect 5000:", r.port===5000?"PASS":"FAIL");
// authority fallback
r = mk({":authority":"example.com:5001"});
console.log("authority host="+r.host+" port="+r.port+" expect 5001:", r.port===5001?"PASS":"FAIL");
// null socket -> fallback, no trust
let req3 = { method:"GET", url:"/", socket:null, headers:{host:"real.test:3000","x-forwarded-host":"spoofed.test:8443"} };
let Tp = build(Request, true);
let rn = new Tp("id",{},req3,"","log");
console.log("null-socket host="+rn.host+" port="+rn.port+" expect real.test:3000/3000:", (rn.host==="real.test:3000"&&rn.port===3000)?"PASS":"FAIL");
// regular (no trust) still works
let reg = new Request("id",{}, {headers:{host:"example.com:80"}}, "", {}, {});
console.log("regular port 80:", reg.port===80?"PASS":"FAIL");
'

