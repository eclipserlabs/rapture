const Request = require("./lib/request");
function mk(headers, remote="127.0.0.1") {
  const req = { method:"GET", url:"/", socket:{remoteAddress:remote}, headers };
  const Tp = Request.buildRequest(Request, true);
  return new Tp("id","p",req,"q","log");
}
// incident: forwarded host with port
let r = mk({host:"127.0.0.1:52176","x-forwarded-host":"api.example.com:8443"});
console.log("incident host="+r.host+" port="+r.port+" hostname="+r.hostname+" (expect api.example.com:8443/8443/api.example.com)");
// forwarded host without port
r = mk({host:"127.0.0.1:3000","x-forwarded-host":"fastify.test"});
console.log("no-port host="+r.host+" port="+r.port+" (expect fastify.test/null per docs)");
// no forwarded host
r = mk({host:"example.com:8080"});
console.log("plain host="+r.host+" port="+r.port+" (expect example.com:8080/8080)");
// base (no trustProxy)
const R2 = Request.buildRequest(Request, false);
let rb = new R2("id","p",{method:"GET",url:"/",socket:{remoteAddress:"127.0.0.1"},headers:{host:"example.com:8080"}},"q","log");
console.log("base host="+rb.host+" port="+rb.port);
// ipv6
r = mk({host:"[::1]:3000","x-forwarded-host":"[::1]:8443"});
console.log("ipv6 host="+r.host+" port="+r.port);
'

