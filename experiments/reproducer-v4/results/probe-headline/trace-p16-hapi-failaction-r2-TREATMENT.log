const Joi = require('./node_modules/@hapi/validate');
(async () => {
  // Test 1: custom failAction expecting data.defaultError (incident case)
  const server = Hapi.server();
  server.route({
    method: 'POST', path: '/orders',
    options: {
      validate: {
        payload: Joi.object({ qty: Joi.number().integer().min(1).required() }),
        failAction: (request, h, err) => {
          const dflt = err?.data?.defaultError;
          if (!dflt) return h.response({ error: 'default validation error unavailable', code: 'E_NO_DEFAULT_ERROR' }).code(500).takeover();
          return h.response({ error: 'validation failed', detail: String(dflt.message).slice(0,60) }).code(400).takeover();
        },
      },
    },
    handler: () => ({ ok: true }),
  });
  // default behavior route
  server.route({ method: 'GET', path: '/def', handler: () => 'ok', options: { validate: { query: Joi.object({ a: Joi.string().min(2) }) } } });
  // expose-detailed route
  server.route({ method: 'GET', path: '/exp', handler: () => 'ok', options: { validate: { query: Joi.object({ a: Joi.string().min(2) }), failAction: (req,h,err) => err } } });
  let res = await server.inject({ method: 'POST', url: '/orders', payload: { qty: 0 } });
  console.log('T1 incident-case:', res.statusCode, res.payload);
  res = await server.inject({ method: 'POST', url: '/orders', payload: { qty: 2 } });
  console.log('T2 valid:', res.statusCode, res.payload);
  res = await server.inject('/?a=1', { url: '/def?a=1' });
  // inject correctly
  res = await server.inject('/def?a=1');
  console.log('T3 default-error:', res.statusCode, res.payload.slice(0,120));
  res = await server.inject('/exp?a=1');
  console.log('T4 expose-detailed:', res.statusCode, res.payload.slice(0,200));
  // check err.data.defaultError presence in expose case
  const server2 = Hapi.server();
  server2.route({ method: 'GET', path: '/', handler: () => 'ok', options: { validate: { query: Joi.object({ a: Joi.string().min(2) }), failAction: (req,h,err) => { return h.response({ hasDefault: !!err?.data?.defaultError, msg: err?.data?.defaultError?.message || null, keys: err.output.payload.validation.keys }).code(400).takeover(); } } } });
  res = await server2.inject('/?a=1');
  console.log('T5 data-check:', res.statusCode, res.payload);
})();
